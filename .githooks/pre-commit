#!/bin/sh
#
# The whole suite before every commit. ~12 s, zero API calls.
#
# INSTALLATION, once per clone:
#
#     git config core.hooksPath .githooks
#
# The hook is versioned here and git is pointed at this directory instead of
# copying it to .git/hooks, because .git/ is not versioned: a copied hook is
# lost on the next clone and nobody notices that it stopped running.
#
# The suite needs no venv —standard library— and does not write to results*/,
# so this hook cannot dirty any record or depend on an installed environment.
#
# TO SKIP IT:  git commit --no-verify
#
# It skips the WHOLE hook, the guard below included, so "it is only
# documentation" is no longer the licence it used to be: what the guard rejects
# IS a documentation commit, and going around it to slip a signature in
# accompanied is the one thing the guard exists to stop. There you split the
# commit; you do not force it.
#
# What survives of that licence is narrower —prose that no snapshot covers, and
# no plan in the same commit— and it never covers a failing test: if a snapshot
# fails, the expected number is NOT updated and the commit is not forced; you
# find out what changed and, if the change is legitimate, you date the erratum
# in the FINDINGS that publishes the figure. It is written in the README,
# section "The tests and the provenance".

set -e

cd "$(git rev-parse --show-toplevel)"

# A signed plan travels alone.
#
# This does NOT forbid committing PREDICTION.md or a PLAN_*.md. It forbids
# committing them ACCOMPANIED, which is what keeps the act findable in the log:
# a signature is an event, and an event that shares a commit with a diagnostic
# is filed under the diagnostic.
#
# WHY IT EXISTS: on 2026-08-13 Sergi's signature of §0 reached the repository
# inside b9b0f5f, a commit whose message talks about the start-budget diagnostic
# and never mentions the signature, because the agent staged with a wildcard and
# swept the working-tree edit in. Nothing was altered; but auditing the plan by
# its own history lands on a diagnostic instead of on a signing event.
#
# Only at the root: docs/PLAN_algo.md is documentation, not a signed plan, so
# anything with a slash in its path falls through to the other pile.
#
# WHAT IT DOES NOT PROTECT AGAINST: being skipped. This runs pre-commit, and
# --no-verify skips it whole. Against an honest slip —a wildcard in a hurry,
# which is what happened on the 13th— that is enough, because a slip is not
# trying to get past anything. Against an agent that sees a commit fail and
# reaches for --no-verify by reflex, it is nothing at all, and no wording here
# changes that. Making it binding would take a server-side hook or a check in
# CI: disproportionate for a failure that has happened once and altered nothing.
# So it stays a guard against carelessness, and says so — a guard trusted for
# more than it can do is worse than no guard, because it moves the vigilance
# off the person without moving the ability to stop anything.

if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
    against=HEAD
else
    against=$(git hash-object -t tree /dev/null)   # first commit: empty tree
fi

plans=""
others=""
staged=$(git diff --cached --name-only "$against")

while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
        */*)                     others="$others $file" ;;
        PREDICTION.md|PLAN_*.md) plans="$plans $file"   ;;
        *)                       others="$others $file" ;;
    esac
done <<END
$staged
END

if [ -n "$plans" ] && [ -n "$others" ]; then
    echo "pre-commit: este commit mezcla un plan firmado con otros ficheros." >&2
    echo "            plan: $plans" >&2
    echo "            resto:$others" >&2
    echo "" >&2
    echo "            Confirmalos por separado. El plan va en su propio commit," >&2
    echo "            con su propio mensaje, para que la firma se encuentre en" >&2
    echo "            el log en vez de quedar archivada bajo otra cosa." >&2
    echo "" >&2
    echo "            git reset$plans    # y confirma el resto primero" >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: no encuentro python3, que es lo unico que hace falta." >&2
    echo "            Si de verdad quieres confirmar sin pasar la suite:" >&2
    echo "            git commit --no-verify" >&2
    exit 1
fi

echo "pre-commit: python3 -m unittest discover"
python3 -m unittest discover
