#!/bin/sh
#
# The whole suite before every commit. ~12 s, zero API calls.
#
# INSTALLATION, once per clone:
#
#     git config core.hooksPath .githooks
#
# The hook is versioned here and git is pointed at this directory instead of
# copying it to .git/hooks, because .git/ is not versioned: a copied hook is
# lost on the next clone and nobody notices that it stopped running.
#
# The suite needs no venv —standard library— and does not write to results*/,
# so this hook cannot dirty any record or depend on an installed environment.
#
# TO SKIP IT:  git commit --no-verify
#
# It makes sense for a documentation-only commit. For any other it does not: if
# a snapshot fails, the expected number is NOT updated and the commit is not
# forced; you find out what changed and, if the change is legitimate, you date
# the erratum in the FINDINGS that publishes the figure. It is written in the
# README, section "The tests and the provenance".

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: no encuentro python3, que es lo unico que hace falta." >&2
    echo "            Si de verdad quieres confirmar sin pasar la suite:" >&2
    echo "            git commit --no-verify" >&2
    exit 1
fi

echo "pre-commit: python3 -m unittest discover"
python3 -m unittest discover
